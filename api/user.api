syntax = "v1"

type (
    RegisterRequest {
        Phone string `json:"phone" validate:"required" label:"手机号"`
        Password string `json:"password" validate:"required,min=6,max=20" label:"密码"`
        RePassword string `json:"re_password" validate:"required,eqfield=Password" label:"确认密码"`
        VerifyCode string `json:"code" validate:"required" label:"验证码"`
    }

    RegisterResponse {
        Token string `json:"token"`
        Nickname string `json:"nickname"`
        Avatar string `json:"avatar"`
    }

    LoginWithPasswordRequest {
        Phone string `json:"phone" validate:"required" label:"手机号"`
        Password string `json:"password" validate:"required,min=6,max=20" label:"密码"`
    }

    LoginWithVerifyCodeRequest {
        Phone string `json:"phone" validate:"required" label:"手机号"`
        VerifyCode string `json:"code" validate:"required,min=6,max=6" label:"验证码"`
    }

    LoginResponse {
        Token string `json:"token"`
        Nickname string `json:"nickname"`
        Avatar string `json:"avatar"`
    }

    GenerateVerifyCodeRequest {
        Phone string `json:"phone" validate:"required" label:"手机号"`
    }

        // TODO: 这里的验证码仅用于测试，实际项目中不应该将验证码返回给客户端
    GenerateVerifyCodeResponse {
        Code string `json:"code"`
    }

    ForgetPasswordRequest {
        Phone string `json:"phone" validate:"required" label:"手机号"`
        VerifyCode string `json:"code" validate:"required,min=6,max=6" label:"验证码"`
    }

    ForgetPasswordResponse {
        ResetToken string `json:"reset_token"`
    }

    ResetPasswordRequest {
        Phone string `json:"phone" validate:"required" label:"手机号"`
        ResetToken string `form:"reset_token" validate:"required" label:"重置凭证"`
        NewPassword string `json:"new_password" validate:"required,min=6,max=20" label:"密码"`
        NewRePassword string `json:"new_re_password" validate:"required,eqfield=NewPassword" label:"确认密码"`
    }
)

@server(
    group: auth
    prefix: /api
)
service CampusService {
    @handler GenerateVerifyCodeHandler
    post /verifycode (GenerateVerifyCodeRequest) returns (GenerateVerifyCodeResponse)

    @handler RegisterHandler
    post /register (RegisterRequest) returns (RegisterResponse)

    @handler LoginWithPasswordHandler
    post /login/password (LoginWithPasswordRequest) returns (LoginResponse)

    @handler LoginWithVerifyCodeHandler
    post /login/verifycode (LoginWithVerifyCodeRequest) returns (LoginResponse)

    @handler ForgetPasswordHandler
    post /forgetpassword (ForgetPasswordRequest) returns (ForgetPasswordResponse)

    @handler ResetPasswordHandler
    post /resetpassword (ResetPasswordRequest) returns ()
}

type ChangePasswordRequest {
    OldPassword string `json:"old_password" validate:"required,min=6,max=20" label:"旧密码"`
    NewPassword string `json:"new_password" validate:"required,min=6,max=20" label:"新密码"`
    NewRePassword string `json:"new_re_password" validate:"required,eqfield=NewPassword" label:"确认新密码"`
}
@server(
    group: auth
    prefix: /api
    middleware: JwtAuthMiddleware
)
service CampusService {
    @handler ChangePasswordHandler
    post /changepassword (ChangePasswordRequest) returns ()
}

type (
    GetAvatarRequest {
        UserID int64 `path:"user_id" label:"用户ID"`
    }
)
@server(
    group: user/profile
    prefix: /api
)
service CampusService {
    @handler GetAvatarHandler
    get /avatar/:user_id (GetAvatarRequest)
}

type (
    UserProfileResponse {
        Phone string `json:"phone"`
        Nickname string `json:"nickname"`
        Avatar string `json:"avatar"`
        Gender int8 `json:"gender"`
    }

    UpdateAvatarResponse {
        AvatarUrl string `json:"avatarUrl"`
    }

    UpdateProfileRequest {
        Nickname string `json:"nickname" validate:"required" label:"昵称"`
        Gender int8 `json:"gender" validate:"required,oneof=0 1 2" label:"性别，0未知，1男，2女"`
    }
)
@server(
    group: user/profile
    prefix: /api/user
    middleware: JwtAuthMiddleware
)
service CampusService {
    @handler GetProfileHandler
    get /profile () returns (UserProfileResponse)

    @handler UpdateAvatarHandler
    put /avatar () returns (UpdateAvatarResponse)

    @handler UpdateProfileHandler
    put /profile (UpdateProfileRequest) returns (UserProfileResponse)
}

type (
    // Step1：验证新手机号（验证码）
    VerifyNewPhoneRequest {
        NewPhone string `json:"new_phone" validate:"required" label:"新手机号"`
        Code string `json:"code" validate:"required" validate:"len=6" label:"验证码"`
    }

    VerifyNewPhoneResponse {
        VerifyToken string `json:"verify_token"`
    }

        // Step2：确认修改手机号
    ChangePhoneRequest {
        VerifyToken string `json:"verify_token" validate:"required" label:"验证令牌"`
        VerifyType int `json:"verify_type" validate:"required,oneof=1 2"` // 1=密码 2=旧手机验证码
        Password string `json:"password,omitempty" validate:"omitempty,min=6,max=20" label:"密码"`
        OldCode string `json:"old_code,optional" label:"旧手机验证码"`
    }

        // 发送验证码（新手机号）
    SendNewPhoneCodeRequest {
        NewPhone string `json:"new_phone" validate:"required"`
    }
)


@server(
    group: user/phone
    prefix: /api/user/phone
    middleware: JwtAuthMiddleware
)
service CampusService {
    // 1️. 给新手机号发送验证码
    @handler SendNewPhoneCodeHandler
    post /send-new-code (SendNewPhoneCodeRequest)

    // 2️. 验证新手机号验证码 → 返回 verifyToken
    @handler VerifyNewPhoneHandler
    post /verify-new (VerifyNewPhoneRequest) returns (VerifyNewPhoneResponse)

    // 3️. 给旧手机号发送验证码（用于二次校验）
    @handler SendOldPhoneCodeHandler
    post /send-old-code

    // 4️. 最终确认修改手机号
    @handler ChangePhoneHandler
    post /confirm (ChangePhoneRequest)
}