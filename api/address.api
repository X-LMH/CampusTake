syntax = "v1"

type (
    AddressItem {
        AddressID int64 `json:"id"`
        Type int8 `json:"type"`
        ContactName string `json:"contact_name"`
        ContactPhone string `json:"contact_phone"`
        Building string `json:"building"`
        Room string `json:"room"`
        Detail string `json:"detail"`
        IsDefault int8 `json:"is_default"`
    }

    AddAddressRequest {
        Type int8 `json:"type" validate:"required,oneof=1 2" label:"地址类型 1=收货地址 2=取件地址"`
        ContactName string `json:"contact_name" validate:"required,min=2,max=50" label:"联系人姓名"`
        ContactPhone string `json:"contact_phone" validate:"required,len=11" label:"手机号"`
        Building string `json:"building" validate:"required,max=50" label:"宿舍楼/教学楼"`
        Room string `json:"room" validate:"required,max=20" label:"房间号"`
        Detail string `json:"detail" validate:"max=255" label:"详细地址"`
    }

    GetAddressDetailRequest {
        AddressID int64 `path:"id" validate:"required" label:"地址ID"`
    }

    DeleteAddressRequest {
        AddressID int64 `path:"id" validate:"required" label:"地址ID"`
    }

    SetDefaultAddressRequest {
        AddressID int64 `path:"id" validate:"required" label:"地址ID"`
    }

    GetAddressListRequest {
        Type int8 `form:"type" validate:"required,oneof=1 2" label:"地址类型 1=收货地址 2=取件地址；"`
    }

    UpdateAddressRequest {
        AddressID int64 `path:"id" validate:"required" label:"地址ID"`
        ContactName string `json:"contact_name" validate:"required,min=2,max=50" label:"联系人姓名"`
        ContactPhone string `json:"contact_phone" validate:"required,len=11" label:"手机号"`
        Building string `json:"building" validate:"required,max=50" label:"宿舍楼/教学楼"`
        Room string `json:"room" validate:"required,max=20" label:"房间号"`
        Detail string `json:"detail" validate:"max=255" label:"详细地址"`
    }
)

@server(
    group: address
    prefix: /api/address
    middleware: JwtAuthMiddleware
)
service CampusService {
    @doc "新增地址"
    @handler AddAddressHandler
    post /add (AddAddressRequest) returns (AddressItem)

    @doc "删除地址"
    @handler DeleteAddressHandler
    delete /delete/:id (DeleteAddressRequest) returns ()

    @doc "更新地址"
    @handler UpdateAddressHandler
    put /update/:id (UpdateAddressRequest) returns (AddressItem)

    @doc "设为默认地址"
    @handler SetDefaultAddressHandler
    put /default/:id (SetDefaultAddressRequest) returns ()

    @doc "获取地址列表"
    @handler GetAddressListHandler
    get /list (GetAddressListRequest) returns ([]AddressItem)

    @doc "获取地址详情"
    @handler GetAddressDetailHandler
    get /detail/:id (GetAddressDetailRequest) returns (AddressItem)
}
